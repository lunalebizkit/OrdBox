  <rd:ReportID>6086f2fc-862f-4895-9486-129e9acb83b5</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="InformesEntity_ViewFacturaCosto">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>ViewFacturaCostoTableAdapter</rd:TableAdapterName>
        <rd:TableName>ViewFacturaCosto</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT     f.FacturaId, f.numerofactura, f.numeroremito, f.fecha, df.cantidad * df.precio AS precio, df.cantidad * pp.precioCompra AS costo, 
                      df.cantidad * df.precio - df.cantidad * pp.precioCompra AS ganancia
FROM         Facturas AS f INNER JOIN
                      DetallesFactura AS df ON f.FacturaId = df.facturaId INNER JOIN
                      ProveedoresProductos AS pp ON df.productoId = pp.ProductoId</CommandText>
        <DataSourceName>DBConnectionString</DataSourceName>
      </Query>
      <Fields>
        <Field Name="FacturaId">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>FacturaId</DataField>
        </Field>
        <Field Name="numerofactura">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>numerofactura</DataField>
        </Field>
        <Field Name="numeroremito">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>numeroremito</DataField>
        </Field>
        <Field Name="fecha">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>fecha</DataField>
        </Field>
        <Field Name="precio">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>precio</DataField>
        </Field>
        <Field Name="costo">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>costo</DataField>
        </Field>
        <Field Name="ganancia">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>ganancia</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="InformesEntity_ViewItemGastosCosto">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>ViewItemGastosCostoTableAdapter</rd:TableAdapterName>
        <rd:TableName>ViewItemGastosCosto</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT     ig.Nombre, gr.valor
FROM         Gastos AS g INNER JOIN
                      Gasto_Item_Relation AS gr ON g.GastoId = gr.GastoId INNER JOIN
                      ItemGastos AS ig ON gr.ItemGasto = ig.ItemGasto_Id</CommandText>
        <DataSourceName>DBConnectionString</DataSourceName>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Nombre</DataField>
        </Field>
        <Field Name="valor">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>valor</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
