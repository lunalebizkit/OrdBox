  <DataSets>
    <DataSet Name="InformesEntity_ViewCompras">
      <Fields>
        <Field Name="numeroRemito">
          <DataField>numeroRemito</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="fecha">
          <DataField>fecha</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Expr1">
          <DataField>Expr1</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="proveedorId">
          <DataField>proveedorId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="proveedor">
          <DataField>proveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cantidad">
          <DataField>cantidad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="precio">
          <DataField>precio</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ProductoId">
          <DataField>ProductoId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="producto">
          <DataField>producto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DBConnectionString</DataSourceName>
        <CommandText>SELECT     r.numeroRemito, CONVERT(varchar, r.fecha, 103) AS Fecha, r.proveedorId, e.nombre AS proveedor, dr.cantidad, dr.precio, p.ProductoId, 
                      p.nombre AS producto
FROM         Remitos AS r INNER JOIN
                      DetallesRemito AS dr ON r.RemitoId = dr.remitoId INNER JOIN
                      Productos AS p ON dr.productoId = p.ProductoId INNER JOIN
                      Entidades AS e ON r.proveedorId = e.EntidadId
WHERE     (r.fecha BETWEEN @FechaIni AND @FechaFin) AND (e.EntidadId = ISNULL(@entidadId, e.EntidadId)) AND (p.ProductoId = ISNULL(@productoId, 
                      p.ProductoId))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableName>ViewCompras</rd:TableName>
        <rd:TableAdapterFillMethod>FillByFechaProProvee</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:TableAdapterName>ViewComprasTableAdapter</rd:TableAdapterName>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
