  <DataSets>
    <DataSet Name="InformesEntity_ViewStockCierreCaja">
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="rubro">
          <DataField>rubro</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="producto">
          <DataField>producto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cantidad">
          <DataField>cantidad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DBConnectionString</DataSourceName>
        <CommandText>SELECT     mp.Id, mp.Descripcion AS rubro, p.nombre AS producto, pp.cantidad
FROM         ProveedoresProductos AS pp INNER JOIN
                      Productos AS p ON pp.ProductoId = p.ProductoId INNER JOIN
                      MaestroProducto AS mp ON p.MaestroProductoId = mp.Id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableName>ViewStockCierreCaja</rd:TableName>
        <rd:TableAdapterName>ViewStockCierreCajaTableAdapter</rd:TableAdapterName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
