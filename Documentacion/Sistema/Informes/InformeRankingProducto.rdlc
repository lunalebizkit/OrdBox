  <DataSets>
    <DataSet Name="InformesEntity_ViewRankingProducto">
      <Fields>
        <Field Name="nombre">
          <DataField>nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CANTIDAD">
          <DataField>CANTIDAD</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="IMPORTE">
          <DataField>IMPORTE</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DBConnectionString</DataSourceName>
        <CommandText>SELECT     P.nombre, SUM(DF.cantidad) AS CANTIDAD, SUM(DF.precio) AS IMPORTE
FROM         Facturas AS F INNER JOIN
                      DetallesFactura AS DF ON F.FacturaId = DF.facturaId INNER JOIN
                      Productos AS P ON DF.productoId = P.ProductoId
WHERE     (F.fecha BETWEEN @FECHAINI AND @FECHAFIN)
GROUP BY P.nombre
ORDER BY IMPORTE DESC</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableName>ViewRankingProducto</rd:TableName>
        <rd:TableAdapterName>ViewRankingProductoTableAdapter</rd:TableAdapterName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
