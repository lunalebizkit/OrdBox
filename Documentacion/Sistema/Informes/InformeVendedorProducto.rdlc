  <DataSets>
    <DataSet Name="InformesEntity_ViewVendedorProducto">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>ViewVendedorProductoTableAdapter</rd:TableAdapterName>
        <rd:TableName>ViewVendedorProducto</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT     vp.VendedorId, e.nombre, p.ProductoId, p.nombre AS producto, vp.Cantidad
FROM         VendedorProductos AS vp INNER JOIN
                      Entidades AS e ON vp.VendedorId = e.EntidadId INNER JOIN
                      Productos AS p ON p.ProductoId = vp.ProductoId</CommandText>
        <DataSourceName>DBConnectionString</DataSourceName>
      </Query>
      <Fields>
        <Field Name="VendedorId">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>VendedorId</DataField>
        </Field>
        <Field Name="nombre">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>nombre</DataField>
        </Field>
        <Field Name="ProductoId">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ProductoId</DataField>
        </Field>
        <Field Name="producto">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>producto</DataField>
        </Field>
        <Field Name="Cantidad">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Cantidad</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
