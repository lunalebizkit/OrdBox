<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="DBConnectionString">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=Note\SQLEXPRESS;Initial Catalog=insumosZanet;Integrated Security=True</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>c27133bf-e9f6-47e7-ba5c-1be50d79a41d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="InformesEntity_ViewStockPedido">
      <Fields>
        <Field Name="Proveedor">
          <DataField>Proveedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="producto">
          <DataField>producto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cantidad">
          <DataField>cantidad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PuntoPedido">
          <DataField>PuntoPedido</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PuntoPedido1">
          <DataField>PuntoPedido1</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="CantidadComprar">
          <DataField>CantidadComprar</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DBConnectionString</DataSourceName>
        <CommandText>SELECT     e.nombre AS Proveedor, p.nombre AS producto, pp.cantidad, pp.PuntoPedido, pp.CantidadMaxima - pp.cantidad AS CantidadComprar
FROM         ProveedoresProductos AS pp INNER JOIN
                      Productos AS p ON pp.ProductoId = p.ProductoId INNER JOIN
                      Entidades AS e ON pp.EntidadId = e.EntidadId
WHERE     (pp.cantidad &lt;= pp.PuntoPedido) AND (e.EntidadId = ISNULL(@proveedorid, e.EntidadId))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableName>ViewStockPedido</rd:TableName>
        <rd:TableAdapterFillMethod>FillByProveedorId</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:TableAdapterName>ViewStockPedidoTableAdapter</rd:TableAdapterName>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
