                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                          </Style>
                          <CanGrow>true</CanGrow>
                          <Value>=(Sum(Fields!Iva.Value, "InformesEntity_ParametrosIva")* sum(Fields!precio.Value * Fields!cantidad.Value))/100</Value>
                        </Textbox>
                      </ReportItems>
