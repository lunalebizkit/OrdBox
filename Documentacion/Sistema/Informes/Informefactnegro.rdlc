  <rd:ReportID>6ba5f5d3-afc9-4132-8401-092565b41604</rd:ReportID>
  <LeftMargin>2.5cm</LeftMargin>
  <DataSets>
    <DataSet Name="InformesEntity_ViewRemitos">
      <rd:DataSetInfo>
        <rd:TableAdapterGetDataMethod>GetDataByRemito</rd:TableAdapterGetDataMethod>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableAdapterFillMethod>FillByRemito</rd:TableAdapterFillMethod>
        <rd:TableAdapterName>ViewRemitosTableAdapter</rd:TableAdapterName>
        <rd:TableName>ViewRemitos</rd:TableName>
      </rd:DataSetInfo>
      <Query>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT     f.FacturaId, f.numerofactura, f.numeroremito, f.fecha, p.nombre AS producto, df.cantidad, df.precio, vc.nombre AS cliente, vv.nombre AS vendedor
FROM         Facturas AS f INNER JOIN
                      DetallesFactura AS df ON f.FacturaId = df.facturaId INNER JOIN
                      Productos AS p ON df.productoId = p.ProductoId INNER JOIN
                      ViewClientes AS vc ON f.clienteId = vc.EntidadId INNER JOIN
                      ViewVendedores AS vv ON f.vendedorId = vv.EntidadId
WHERE     (f.fecha BETWEEN @fechaini AND @fechafin) AND (f.numeroremito &lt;&gt; 0) AND (vv.EntidadId = ISNULL(@clienteId, vv.EntidadId))</CommandText>
        <DataSourceName>DBConnectionString</DataSourceName>
      </Query>
      <Fields>
        <Field Name="FacturaId">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>FacturaId</DataField>
        </Field>
        <Field Name="numerofactura">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>numerofactura</DataField>
        </Field>
        <Field Name="numeroremito">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>numeroremito</DataField>
        </Field>
        <Field Name="fecha">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>fecha</DataField>
        </Field>
        <Field Name="producto">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>producto</DataField>
        </Field>
        <Field Name="cantidad">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>cantidad</DataField>
        </Field>
        <Field Name="precio">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>precio</DataField>
        </Field>
        <Field Name="cliente">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>cliente</DataField>
        </Field>
        <Field Name="vendedor">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>vendedor</DataField>
        </Field>
