  <DataSets>
    <DataSet Name="InformesEntity_ViewCierreCaja">
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="idUsuario">
          <DataField>idUsuario</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FacturaId">
          <DataField>FacturaId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Detalle">
          <DataField>Detalle</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="importeTotal">
          <DataField>importeTotal</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="fecha">
          <DataField>fecha</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="nombre">
          <DataField>nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cantidadcigarrillo">
          <DataField>cantidadcigarrillo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="cantidadtarjeta">
          <DataField>cantidadtarjeta</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="saldoingresado">
          <DataField>saldoingresado</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="tipoComprobante">
          <DataField>tipoComprobante</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DBConnectionString</DataSourceName>
        <CommandText>SELECT        Apertura.Id, DetalleManejoCaja.tipoComprobante, Facturas.FacturaId, 'Factura - ' + CONVERT(nvarchar, Facturas.FacturaId) AS Detalle, Facturas.importeTotal, 
                         Facturas.fecha, Cierre.saldoingresado, Entidades.Nombre
FROM            ManejoCaja AS Apertura INNER JOIN
                         ManejoCaja AS Cierre ON Apertura.Id = Cierre.idApertura INNER JOIN
                         DetalleManejoCaja ON DetalleManejoCaja.idManejoCaja = Apertura.Id INNER JOIN
                         Facturas ON Facturas.FacturaId = DetalleManejoCaja.idComprobante INNER JOIN
                         Entidades ON Apertura.idUsuario = Entidades.EntidadId
WHERE        (DetalleManejoCaja.tipoComprobante = 1) AND (Apertura.fecha BETWEEN @fechaIni AND @fechaFin)
UNION
SELECT        Apertura.Id, DetalleManejoCaja_2.tipoComprobante, Remitos.RemitoId, 'Factura Compra - ' + CONVERT(nvarchar, Remitos.numeroRemito) AS Detalle, 
                         Remitos.importeTotal * - 1 AS importeTotal, Remitos.fecha, Cierre.saldoingresado, Entidades_2.Nombre
FROM            ManejoCaja AS Apertura INNER JOIN
                         ManejoCaja AS Cierre ON Apertura.Id = Cierre.idApertura INNER JOIN
                         DetalleManejoCaja AS DetalleManejoCaja_2 ON DetalleManejoCaja_2.idManejoCaja = Apertura.Id INNER JOIN
                         Remitos ON Remitos.RemitoId = DetalleManejoCaja_2.idComprobante INNER JOIN
                         Entidades AS Entidades_2 ON Apertura.idUsuario = Entidades_2.EntidadId
WHERE        (DetalleManejoCaja_2.tipoComprobante = 2) AND (Apertura.fecha BETWEEN @fechaIni AND @fechaFin)
UNION
SELECT        Apertura.Id, DetalleManejoCaja_1.tipoComprobante, AjustesCaja.Id AS Expr1, 'Ajuste de Caja - ' + CONVERT(nvarchar, AjustesCaja.Id) AS Detalle, 
                         AjustesCaja.Importe AS importeTotal, AjustesCaja.Fecha, Cierre.saldoingresado, Entidades_1.Nombre
FROM            ManejoCaja AS Apertura INNER JOIN
                         ManejoCaja AS Cierre ON Apertura.Id = Cierre.idApertura INNER JOIN
                         DetalleManejoCaja AS DetalleManejoCaja_1 ON DetalleManejoCaja_1.idManejoCaja = Apertura.Id INNER JOIN
                         AjustesCaja ON AjustesCaja.Id = DetalleManejoCaja_1.idComprobante INNER JOIN
                         Entidades AS Entidades_1 ON Apertura.idUsuario = Entidades_1.EntidadId
WHERE        (DetalleManejoCaja_1.tipoComprobante = 3) AND (Apertura.fecha BETWEEN @fechaIni AND @fechaFin)</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
