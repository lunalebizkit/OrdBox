  <DataSets>
    <DataSet Name="InformesEntity_ViewFacturas">
      <Fields>
        <Field Name="FacturaId">
          <DataField>FacturaId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="numerofactura">
          <DataField>numerofactura</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="numeroremito">
          <DataField>numeroremito</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="fecha">
          <DataField>fecha</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="producto">
          <DataField>producto</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="cantidad">
          <DataField>cantidad</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="precio">
          <DataField>precio</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="cliente">
          <DataField>cliente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vendedor">
          <DataField>vendedor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>DBConnectionString</DataSourceName>
        <CommandText>SELECT     f.FacturaId, f.numerofactura, CONVERT(varchar, f.fecha, 103) AS Fecha, p.nombre AS producto, df.cantidad, df.precio
FROM         Facturas AS f INNER JOIN
                      DetallesFactura AS df ON f.FacturaId = df.facturaId INNER JOIN
                      Productos AS p ON df.productoId = p.ProductoId
WHERE     (f.fecha BETWEEN @fechaini AND @fechafin) AND (p.ProductoId = ISNULL(@productoid, p.ProductoId))</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>InformesEntity</rd:DataSetName>
        <rd:TableName>ViewFacturas</rd:TableName>
        <rd:TableAdapterName>ViewFacturasTableAdapter</rd:TableAdapterName>
        <rd:TableAdapterFillMethod>FillByFacturas</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetDataByFacturas</rd:TableAdapterGetDataMethod>
      </rd:DataSetInfo>
    </DataSet>
